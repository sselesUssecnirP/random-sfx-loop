{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "rootDir": "src",
        "outDir": "./dist/",
        "strict": true,
        "moduleResolution": "nodenext",
        "importHelpers": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": true,
        "typeRoots": [
            "node_modules/@types"
    ],
    "sourceMap": false,
    "baseUrl": "./"
    },
    "files": [
        "src/start.ts"
    ],
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}