{
  "name": "random-sfx-loop",
  "version": "4.2.0",
  "description": "plays random sfx at random intervals",
  "icon": "icon.ico",
  "main": "./dist/start.js",
  "isBuildZip": false,
  "scripts": {
    "clean": "rmdir /s /q dist || exit 0",
    "compile": "tsc --pretty && node dist/copyDir",
    "test": "npm run clean && npm run compile && electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "npm run package && npm run make",
    "publish": "electron-forge publish"
  },
  "author": "sselesUssecnirP",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-flatpak": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-snap": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron-forge/shared-types": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.10.1",
    "electron": "^23.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.8",
    "ascii-table3": "^1.0.1",
    "discord.js": "^14.25.1",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "7.14.0",
    "random": "^5.4.1",
    "update-electron-app": "^3.1.1"
  },
  "config": {
    "forge": "./dist/forge.config.js"
  }
